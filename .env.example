# =============================================================
# KONFIGURASI FIREBASE (Salin file ini menjadi .env lalu isi!)
# =============================================================
# Cara mendapatkan: Firebase Console -> Project Settings ->
# "Your apps" -> Register app (Web/Flutter?) -> pilih Web ->
# salin nilai config di sawah ke file .env ini.
# Simpan nilai dalam tanda kutip ganda, contoh: "123456789"

EXPO_PUBLIC_FIREBASE_API_KEY="ISI_API_KEY_KAMU"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="kampus-finder.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="kampus-finder"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="kampus-finder.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="ISI_SENDER_ID"
EXPO_PUBLIC_FIREBASE_APP_ID="ISI_APP_ID"
